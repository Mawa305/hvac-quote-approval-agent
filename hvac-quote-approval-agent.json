    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer request: {{ $('Webhook').first().json.body.service }}, customer: {{ $('Webhook').first().json.body.customer_name }}, area: {{ $('Webhook').first().json.body.area }}\nDraft quote: {{ $json.output }}",
        "options": {
          "systemMessage": "You are a quote reviewer for an HVAC company in Lahore.\nYou receive a customer request and a draft quote. Check the draft against these rules:\n1. The customer name and area in the draft match the request.\n2. Any price in the draft must come from the request. If the request has no price list, the draft must say \"to be confirmed after inspection\".\n3. The service in the draft matches the service in the request.\n4. The draft does not invent details that are not in the request.\n\nReturn ONLY valid JSON, with no extra text or markdown:\n{\n  \"approved\": true or false,\n  \"notes\": \"if rejected, say exactly what to fix in one or two sentences; if approved, write 'ok'\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        800,
        176
      ],
      "id": "95f156fd-cb75-40f7-8bf0-b9ed3bfca3a8",
      "name": "Reviewer Agent",
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
