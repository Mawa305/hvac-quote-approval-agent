    {
      "parameters": {
        "promptType": "define",
        "text": "=Service request: {{ $('Webhook').first().json.body.service }}\nCustomer: {{ $('Webhook').first().json.body.customer_name }}\nArea: {{ $('Webhook').first().json.body.area }}\n{{ $json.notes ? 'Previous review feedback: ' + $json.notes : '' }}",
        "options": {
          "systemMessage": "You are a quote drafter for an HVAC company in Lahore.\nYou receive a customer service request. Write a short quote with:\n- Service to be done\n- Price range in PKR: write only if a price list is given in the request. Otherwise write \"to be confirmed after inspection\". Never guess a price.\n- Estimated timeline\n\nUse only the information in the request. Do not invent details.\nIf feedback from a previous review is provided, fix those issues in the new draft.\n\nReturn plain text, 5 to 7 lines.\nOutput only the quote itself. Never repeat the request fields or labels like \"Previous review feedback\" in the quote."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
        192
      ],
      "id": "1cf5efbb-d1d5-4435-9bf1-1caf186b8e29",
      "name": "Drafter Agent",
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
