    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\n\nlet data;\ntry {\n  data = JSON.parse(\n    raw.replace(/```json|```/g, '').trim()\n  );\n} catch (err) {\n  data = {\n    approved: false,\n    notes: 'Reviewer output could not be parsed. Regenerate the quote in plain text.'\n  };\n}\n\nreturn [{\n  json: {\n    approved: data.approved === true,\n    notes: data.notes || 'ok',\n    revision: $runIndex + 1\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        176
